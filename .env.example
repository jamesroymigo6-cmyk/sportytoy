[TEMPLATE]
# Copy this file to .env on your server and replace all values.
APP_ENV=production
APP_DEBUG=0
APP_URL=https://sportsync.example.com
# PHP and the database session both use this zone, so stored times, lockouts and
# reminders stay consistent. Change it if you deploy outside the Philippines.
APP_TIMEZONE=Asia/Manila

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sports_event_system
DB_USERNAME=sportsync_user
DB_PASSWORD=CHANGE_THIS_STRONG_DATABASE_PASSWORD

SESSION_IDLE_SECONDS=7200
MAIL_FROM=no-reply@sportsync.example.com
MAIL_FROM_NAME=SportSync

# SMS notifications (SMSGate — SMS Gateway for Android, https://sms-gate.app)
# 1. Install the SMSGate Android app and register it with your account.
# 2. Create the account at the SMSGate Web Dashboard, then fill in the
#    username and password below (Basic auth against the cloud API).
# 3. Set SMS_PROVIDER=smsgate to activate; 'disabled' turns SMS off.
# Cloud API: https://api.sms-gate.app  (use a LAN address for a self-hosted
# gateway; messages are dispatched by the registered Android device's SIM).
SMS_PROVIDER=disabled
SMSGATE_API_URL=https://api.sms-gate.app
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMS_SENDER=SportSync

# Optional token for web-triggered cron jobs. Prefer CLI cron when available.
CRON_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ------------------------------------------------------------------
# Clerk email authentication (optional)
# ------------------------------------------------------------------
# Create an application at https://dashboard.clerk.com, then:
#   1. Copy the publishable + secret keys below.
#   2. Set CLERK_FAPI_URL to your instance's Frontend API URL
#      (Clerk Dashboard -> API Keys -> Frontend API), e.g.
#      https://your-app.clerk.accounts.dev
#   3. In Clerk Dashboard -> Webhooks, create an endpoint pointing to
#      https://YOUR-HOST/auth/clerk_webhook.php and paste its Svix
#      signing secret into CLERK_WEBHOOK_SECRET.
# Leave CLERK_SECRET_KEY empty to keep the classic email+password auth only.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FAPI_URL=
CLERK_WEBHOOK_SECRET=

# ------------------------------------------------------------------
# GCash merchandise payments
# ------------------------------------------------------------------
# GCASH_MODE:
#   manual — customers send the exact amount to GCASH_NUMBER, then enter the
#            receipt reference at checkout. Order sits as "verifying" until
#            management confirms it on the shop page (Mark paid / Reject).
#   auto   — PayMongo (https://paymongo.com) hosted checkout limited to GCash.
#            Customers pay on a secure GCash page and the order confirms
#            itself. Requires PAYMONGO_SECRET_KEY (sk_test_... or sk_live_...).
#            PayMongo requires HTTPS redirect URLs in live mode, so set APP_URL
#            to your https:// address. Test payments need test keys.
# Leave GCASH_NUMBER empty (and no PayMongo key) to turn GCash off entirely.
GCASH_MODE=manual
GCASH_NUMBER=09123456789
GCASH_ACCOUNT_NAME=SportSync Shop
PAYMONGO_SECRET_KEY=

# ------------------------------------------------------------------
# Advanced schedule prevention (tune venue booking rules)
# ------------------------------------------------------------------
# Dead time required between two bookings at the same venue (minutes).
SCHEDULE_BUFFER_MINUTES=30
# Venue operating hours (local time). Events must start no earlier than
# SCHEDULE_OPEN_HOUR and end no later than SCHEDULE_CLOSE_HOUR.
SCHEDULE_OPEN_HOUR=6
SCHEDULE_CLOSE_HOUR=22
# Shortest / longest allowed booking.
SCHEDULE_MIN_MINUTES=30
SCHEDULE_MAX_HOURS=12
# Bookings must be made at least this many days ahead, and no more than
# SCHEDULE_MAX_ADVANCE_DAYS ahead.
SCHEDULE_ADVANCE_DAYS=1
SCHEDULE_MAX_ADVANCE_DAYS=180
# How many events one user may schedule on the same day.
SCHEDULE_MAX_PER_DAY=1
