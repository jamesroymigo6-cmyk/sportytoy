Options -Indexes
DirectoryIndex landing.php index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# Force HTTPS in production when Apache is directly serving TLS.
# Uncomment the next two lines if your host does not already force HTTPS.
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct access to private folders/files.
RewriteRule ^(?:config|database|storage)/ - [F,L,NC]
RewriteRule ^(?:\.env|\.git|composer\.(?:json|lock)|README\.md)$ - [F,L,NC]
</IfModule>

<FilesMatch "(^\.|\.(?:sql|log|ini|env|bak|md)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
